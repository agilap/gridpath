# Backend-only vars. All credentials live in the root .env.example — copy that to .env.
# This file only documents the two vars that are NOT in the root example.

# Direct PostgreSQL connection (Supabase → Settings → Database → Connection string → URI)
# Needed only for setup_supabase.py — not required at runtime.
SUPABASE_DB_URL=

# Comma-separated origins allowed for CORS, e.g. http://localhost:5173,https://github.com/agilap/gridpath
FRONTEND_URL=http://localhost:5173

# Set to "production" in Railway to enable SameSite=None cookies and strict security.
ENV=development
